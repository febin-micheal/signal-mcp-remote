# signal-mcp-remote configuration. Copy to ~/.config/signal-mcp-remote/env
# (mode 600) and point the systemd unit's EnvironmentFile= at it. Every variable
# is optional.

# Address and port the MCP server listens on. Keep it on the loopback
# interface and put a tunnel or reverse proxy in front for remote clients.
SIGNAL_MCP_BIND=127.0.0.1
SIGNAL_MCP_PORT=8766

# File holding the bearer secret. Created on first start (mode 600 in a 700 folder).
SIGNAL_MCP_SECRET_FILE=~/.config/signal-mcp-remote/secret

# Public host names that reach this server, comma-separated, for example the
# hostname of a Cloudflare Tunnel route. Requests for any other Host get 421.
# The first one is used by `signal-mcp-remote check` for its live checks.
SIGNAL_MCP_PUBLIC_HOSTS=

# signal-cli's HTTP daemon, as started with: signal-cli -a <ACCOUNT> daemon --http 127.0.0.1:7583
SIGNAL_CLI_DAEMON_URL=http://127.0.0.1:7583

# The signal-cli binary, used for version checks. Default: signal-cli on PATH.
SIGNAL_CLI_BIN=

# The only folder, besides signal-mcp's attachment folder, that files may be sent from.
SIGNAL_MCP_OUTBOX=~/signal-outbox

# Where check-update remembers what it already reported.
SIGNAL_MCP_STATE_DIR=~/.local/state/signal-mcp-remote

# systemd user units that `signal-mcp-remote check` expects to be active.
SIGNAL_MCP_CHECK_UNITS=signal-cli-daemon,signal-mcp-remote
